// Welco data model. See docs/02-database-schema.md.
// Enum-like columns are Strings validated by @welco/shared so SQLite and PostgreSQL behave the same.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("CLIENT")
  locale       String    @default("en")
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0)
  /// Staff contact details (visible to admins and to whoever reviews their time-off requests).
  phone          String?
  whatsapp       String?
  altEmail       String?
  emergencyName  String?
  emergencyPhone String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientProfile    ClientProfile?
  developerProfile DeveloperProfile?
  projects         Project[]         @relation("ClientProjects")
  memberships      ProjectMember[]
  messages         Message[]         @relation("MessageAuthor")
  moderated        Message[]         @relation("MessageModerator")
  files            File[]
  tasksAssigned    Task[]            @relation("TaskAssignee")
  tasksCreated     Task[]            @relation("TaskCreator")
  notes            Note[]
  notifications    Notification[]
  aiUsage          AIUsage[]
  aiMessages       AIMessage[]
  technicalReports TechnicalReport[]      @relation("TechnicalReportCreator")
  reportShares     TechnicalReportShare[] @relation("TechnicalReportRecipient")
  reportSharesSent TechnicalReportShare[] @relation("TechnicalReportSharer")
  timeOffRequests  TimeOffRequest[]       @relation("TimeOffRequester")
  timeOffToReview  TimeOffRequest[]       @relation("TimeOffApprover")
  timeOffAssigned  TimeOffRequest[]       @relation("TimeOffAssigner")
  timeOffDecided   TimeOffRequest[]       @relation("TimeOffDecider")
  auditLogs        AuditLog[]
  events           ProjectEvent[]

  @@index([role])
}

model ClientProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String   @default("")
  industry      String?
  country       String?
  phone         String?
  website       String?
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeveloperProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  skills    Json     @default("[]")
  capacity  Int      @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowTemplate {
  id          String         @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean        @default(false)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       WorkflowStep[]
  projects    Project[]
}

model WorkflowStep {
  id          String           @id @default(cuid())
  templateId  String
  template    WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key         String
  title       String
  description String?
  icon        String?
  order       Int
  enabled     Boolean          @default(true)
  conditions  Json?
  i18n        Json?
  questions   Question[]

  @@unique([templateId, key])
  @@index([templateId, order])
}

model Question {
  id          String       @id @default(cuid())
  stepId      String
  step        WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  key         String
  type        String
  label       String
  placeholder String?
  helpText    String?
  required    Boolean      @default(false)
  enabled     Boolean      @default(true)
  order       Int
  options     Json?
  conditions  Json?
  validation  Json?
  aiHint      String?
  i18n        Json?

  @@index([stepId, order])
}

model Project {
  id               String    @id @default(cuid())
  code             String    @unique
  title            String
  clientId         String
  client           User      @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  templateId       String?
  template         WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  workflowSnapshot Json
  status           String    @default("STARTED")
  priority         String    @default("MEDIUM")
  projectType      String?
  progress         Int       @default(0)
  currentStepKey   String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  startDate        DateTime?
  dueDate          DateTime?
  aiBrief          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members    ProjectMember[]
  steps      ProjectStep[]
  answers    Answer[]
  events     ProjectEvent[]
  files      File[]
  threads    Thread[]
  tasks      Task[]
  notes      Note[]
  aiMessages AIMessage[]
  aiUsage    AIUsage[]
  technicalReports TechnicalReport[]

  @@index([clientId])
  @@index([status])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String
  assignedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectStep {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey     String
  status      String    @default("PENDING")
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, stepKey])
}

model Answer {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questionKey String
  stepKey     String
  value       Json?
  updatedAt   DateTime @updatedAt

  @@unique([projectId, questionKey])
}

model ProjectEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type       String
  title      String
  body       String?
  visibility String   @default("CLIENT")
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model File {
  id           String   @id @default(cuid())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  questionKey  String?
  category     String   @default("ATTACHMENT")
  visibility   String   @default("CLIENT")
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Thread {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  locked    Boolean   @default(false)
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([projectId, type])
}

model Message {
  id            String    @id @default(cuid())
  threadId      String
  thread        Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?     @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind          String    @default("MESSAGE")
  body          String
  status        String    @default("VISIBLE")
  resolvedAt    DateTime?
  moderatedById String?
  moderatedBy   User?     @relation("MessageModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([threadId, createdAt])
  @@index([status])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  order       Int       @default(0)
  /// Per-project ticket number (0 = legacy task created before numbering).
  number      Int       @default(0)
  /// MANUAL, or REQUIREMENT when the ticket was generated from the client's requirements.
  source      String    @default("MANUAL")
  /// Journey step the ticket traces back to (a requirement group).
  stepKey     String?
  reportId    String?
  report      TechnicalReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  estimateHours Int?
  /// Set while the developer is blocked; the project manager is notified.
  blockedReason String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([assigneeId, status])
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AISettings {
  id                Int      @id @default(1)
  enabled           Boolean  @default(true)
  model             String   @default("gemini-3.5-flash-lite")
  /// Comma-separated backups tried in order when the main model is overloaded or rate-limited.
  fallbackModels    String   @default("gemini-2.5-flash-lite")
  apiKeyEnc         String?
  persona           String   @default("consultant")
  systemPrompt      String   @default("")
  temperature       Float    @default(0.6)
  maxOutputTokens   Int      @default(2048)
  dailyUserLimit    Int      @default(40)
  monthlyTokenLimit Int      @default(2000000)
  allowSuggest      Boolean  @default(true)
  allowImprove      Boolean  @default(true)
  allowExplain      Boolean  @default(true)
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

model AIUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind         String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  mock         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AIMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      String
  content   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model TechnicalReport {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version               Int
  locale                String   @default("en")
  content               String
  model                 String?
  mock                  Boolean  @default(false)
  requirementsUpdatedAt DateTime
  answerCount           Int      @default(0)
  createdById           String
  createdBy             User     @relation("TechnicalReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime @default(now())
  shares                TechnicalReportShare[]
  tasks                 Task[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model TechnicalReportShare {
  id          String          @id @default(cuid())
  reportId    String
  report      TechnicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User            @relation("TechnicalReportRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sharedById  String
  sharedBy    User            @relation("TechnicalReportSharer", fields: [sharedById], references: [id], onDelete: Restrict)
  sharedAt    DateTime        @default(now())

  @@unique([reportId, recipientId])
  @@index([recipientId, sharedAt])
}

model TimeOffRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("TimeOffRequester", fields: [userId], references: [id], onDelete: Cascade)
  /// LEAVE (whole days) or PERMISSION (a few hours on one day).
  type         String
  leaveKind    String?
  startDate    DateTime
  endDate      DateTime
  startTime    String?
  endTime      String?
  reason       String    @default("")
  /// PENDING → APPROVED | REJECTED, or CANCELLED by the requester.
  status       String    @default("PENDING")
  /// The project manager an admin asked to decide.
  approverId   String?
  approver     User?     @relation("TimeOffApprover", fields: [approverId], references: [id], onDelete: SetNull)
  assignedById String?
  assignedBy   User?     @relation("TimeOffAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  decidedById  String?
  decidedBy    User?     @relation("TimeOffDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
  @@index([approverId, status])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
