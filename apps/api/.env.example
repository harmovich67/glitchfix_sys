# ── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Long random string: signs JWTs and encrypts the stored AI API key
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Database. SQLite for local dev (default). To use MySQL instead, set a mysql:// URL, e.g.
#    DATABASE_URL="mysql://user:password@localhost:3306/welco"
#    then run:  npm run db:mysql:setup -w @welco/api   (see README → "Using MySQL")
DATABASE_URL="file:./dev.db"

# ── AI (optional — admin can also set the key in the AI settings screen)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Email (optional — without SMTP, emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Welco <no-reply@welco.local>"
